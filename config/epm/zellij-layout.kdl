// Insomnia System — EPM Zellij Dashboard Layout
// Installed to: /etc/insomnia/epm/zellij-layout.kdl
//
// Power rule: nothing that polls runs unless you are looking at it.
// btop / nmtui / lf start *suspended* (press Enter in the pane to run them),
// and the only always-on pane is insomnia-batt at a 10 s refresh.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }

    tab name="OPS" focus=true {
        pane split_direction="vertical" {
            pane name="//shell" size="64%" focus=true
            pane split_direction="horizontal" size="36%" {
                pane name="//power" command="insomnia-batt" size="62%"
                pane name="//aux"
            }
        }
    }

    tab name="SYS" {
        pane name="//btop" command="btop" start_suspended=true {
            args "--utf-force"
        }
    }

    tab name="NET" {
        pane split_direction="horizontal" {
            pane name="//nmtui" command="nmtui" start_suspended=true size="60%"
            pane name="//bandwhich" command="sudo" start_suspended=true {
                args "bandwhich"
            }
        }
    }

    tab name="FILES" {
        pane name="//lf" command="lf" start_suspended=true
    }
}
