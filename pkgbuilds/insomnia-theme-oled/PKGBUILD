# Maintainer: ProgrammerKrot
pkgname=insomnia-theme-oled
pkgver=0.1
pkgrel=1
pkgdesc="Insomnia System OLED-oriented GNOME dconf profile"
arch=('any')
url="https://github.com/ProgrammerKrot/InsomniaSys-beta"
license=('MIT')
depends=(
  'papirus-icon-theme'
)
optdepends=(
  'gnome-shell: apply dconf profile'
  'gnome-tweaks: tweak GTK theme'
  'plymouth: boot splash (theme assets planned)'
)
source=(
  "01-oled-dark::https://raw.githubusercontent.com/ProgrammerKrot/InsomniaSys-beta/main/config/gnome/dconf-insomnia.ini"
)
sha256sums=('SKIP')

package() {
  install -Dm644 01-oled-dark \
    "$pkgdir/etc/dconf/db/insomnia.d/01-oled-dark"
  install -dm755 "$pkgdir/etc/dconf/profile"
  printf '%s\n' 'user-db:user' 'system-db:insomnia' \
    > "$pkgdir/etc/dconf/profile/insomnia"
}

post_install() {
  if command -v dconf >/dev/null 2>&1; then
    dconf update || true
  fi
  echo "Insomnia GNOME dconf profile installed."
  echo "Plymouth theme files are not in this package yet."
}
