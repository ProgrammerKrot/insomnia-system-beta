package() {
  install -Dm755 insomnia-ctl      "$pkgdir/usr/local/bin/insomnia-ctl"
  install -Dm755 epm-launch        "$pkgdir/usr/local/bin/epm-launch"
  install -Dm755 insomnia-persist  "$pkgdir/usr/local/bin/insomnia-persist"
  install -Dm644 zshrc             "$pkgdir/etc/zsh/zshrc"
  install -Dm644 zellij-layout.kdl "$pkgdir/etc/insomnia/epm/zellij-layout.kdl"
  install -Dm644 starship.toml     "$pkgdir/etc/insomnia/starship.toml"
  install -Dm644 btop.conf         "$pkgdir/etc/skel/.config/btop/btop.conf"
  install -Dm755 insomnia-power    "$pkgdir/usr/local/bin/insomnia-power"
  install -Dm755 insomnia-batt     "$pkgdir/usr/local/bin/insomnia-batt"
  install -Dm755 insomnia-palette  "$pkgdir/usr/local/bin/insomnia-palette"
  install -Dm644 zellij-config.kdl "$pkgdir/etc/insomnia/epm/zellij-config.kdl"
  install -Dm644 90-insomnia.conf  "$pkgdir/etc/tlp.d/90-insomnia.conf"
  install -Dm644 90-insomnia-power.rules "$pkgdir/etc/udev/rules.d/90-insomnia-power.rules"
  install -Dm644 insomnia-neon.theme "$pkgdir/usr/share/btop/themes/insomnia-neon.theme"
  install -Dm644 vimrc             "$pkgdir/etc/skel/.vimrc"
}
