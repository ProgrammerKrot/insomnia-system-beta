vulkan-radeon
xf86-video-amdgpu
xf86-video-nouveau
intel-ucode
amd-ucode
libva-intel-driver
libva-mesa-driver

# ── Plymouth (Boot Splash) ─────────────────────────────────────
plymouth

# ── Graphical Installer (Calamares) ───────────────────────────
