# btop theme — INSOMNIA//NEON (used in terminal emulators; on the raw Linux
# console btop falls back to TTY mode, which inherits insomnia-palette)

theme[main_bg]="#000000"
theme[main_fg]="#b8bccf"
theme[title]="#00e5ff"
theme[hi_fg]="#ff2fd0"
theme[selected_bg]="#2a0f2a"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#3a3f55"
theme[graph_text]="#6ff6ff"
theme[meter_bg]="#14161f"
theme[proc_misc]="#ff2fd0"
theme[cpu_box]="#ff2fd0"
theme[mem_box]="#00e5ff"
theme[net_box]="#2bff88"
theme[proc_box]="#3d6bff"
theme[div_line]="#3a3f55"
theme[temp_start]="#2bff88"
theme[temp_mid]="#f5f05a"
theme[temp_end]="#ff2a55"
theme[cpu_start]="#00e5ff"
theme[cpu_mid]="#ff2fd0"
theme[cpu_end]="#ff2a55"
theme[free_start]="#2bff88"
theme[free_mid]="#00e5ff"
theme[free_end]="#3d6bff"
theme[cached_start]="#3d6bff"
theme[cached_mid]="#00e5ff"
theme[cached_end]="#6ff6ff"
theme[available_start]="#f5f05a"
theme[available_mid]="#2bff88"
theme[available_end]="#00e5ff"
theme[used_start]="#ff2fd0"
theme[used_mid]="#ff5c7a"
theme[used_end]="#ff2a55"
theme[download_start]="#00e5ff"
theme[download_mid]="#3d6bff"
theme[download_end]="#ff2fd0"
theme[upload_start]="#2bff88"
theme[upload_mid]="#f5f05a"
theme[upload_end]="#ff2a55"
theme[process_start]="#00e5ff"
theme[process_mid]="#ff2fd0"
theme[process_end]="#ff2a55"
